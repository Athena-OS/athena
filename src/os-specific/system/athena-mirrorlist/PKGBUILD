pkgrel=1
pkgdesc='Athena OS mirrorlist.'
arch=('any')
license=('custom:unknown')
backup=('etc/pacman.d/athena-mirrorlist')
source=("athena-mirrorlist")
sha512sums=('247926428c3a9e38b154e69037d537e72158f3b403c45e6d443744a7c6807b9e0f46ad6deb44de62ca74bf2a6650a2336b87bf6195c8ea850ff902296a288200')

package() {
  install -dm755 "$pkgdir/etc/pacman.d"

  install -Dm644 -t "$pkgdir/etc/pacman.d/" $pkgname
}

