pkgname=athena-keyring
pkgver=1.0.1
pkgrel=1
pkgdesc='Keyring for Athena.'
arch=('any')
license=('custom:unknown')
source=("$pkgname.tar.gz")
sha512sums=('52aa9127e90e45042266d3a12f3dfebb6fefe5e6ec2c87af0b6e0be9a3e99510caf1d1b9a4a37a77da811a6b776cd0165e5796fff55c660ef2f36644afa498c4')

package() {
  mkdir -p "${pkgdir}/usr/share/pacman/keyrings"

  cp -rf "${srcdir}"/usr/share/pacman/keyrings/* "${pkgdir}/usr/share/pacman/keyrings/"
}

