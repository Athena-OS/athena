pkgname=athena-nighttab
pkgver=1.0.0
pkgrel=3
pkgdesc='NightTab browser themes for Athena.'
arch=('any')
license=('custom:unknown')
source=("$pkgname.tar.gz")
sha512sums=('609d34cc688c7c8cd647ddc3748bcbf902d97220ec08d48674a4615fa59c980445a3246ea2031619b8ede6681247a998b90a8c533e8676735ba1f2f721cd2016')

package() {
  install -dm755 "$pkgdir/usr/share/nighttab"

  install -Dm644 ./usr/share/nighttab/athena_astronaut.json "$pkgdir/usr/share/nighttab/"
  install -Dm644 ./usr/share/nighttab/athena_persona_5.json "$pkgdir/usr/share/nighttab/"
}

