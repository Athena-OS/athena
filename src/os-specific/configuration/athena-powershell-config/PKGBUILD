pkgname=athena-powershell-config
pkgver=1.0.0
pkgrel=2
pkgdesc='PowerShell configuration for Athena.'
arch=('any')
license=('custom:unknown')
depends=('powershell-bin')
source=("Microsoft.PowerShell_profile.ps1")
sha512sums=('80d3fa9cf3f6784f4a7204f30d3700899f8420c91c7d78605a0abb4dd6a61eaeac74ac995385269107870411ca6a3d40efe9f92b284f8b1e6d8551272cd08623')

package() {
  install -dm 755 "$pkgdir/etc/skel/.config/powershell"

  install -Dm 755 Microsoft.PowerShell_profile.ps1 "${pkgdir}/etc/skel/.config/powershell/Microsoft.PowerShell_profile.ps1"
}

