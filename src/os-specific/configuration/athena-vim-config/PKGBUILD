pkgname=athena-vim-config
pkgver=1.0.0
pkgrel=2
pkgdesc='Vim configuration for Athena.'
arch=('any')
license=('custom:unknown')
depends=('vim')
source=("$pkgname.tar.gz")
sha512sums=('2106a2a411864cc7706aedf3eb43ef1ff6c1791ffc494d5ec7af0d788654991b89ef511436f32bca694da5736c2a239dc3bfa91133e65b6114bc1bd109850ec3')

package() {
  install -dm755 "$pkgdir/etc/skel"

  cp -rf ./etc/skel/.vim_runtime "$pkgdir/etc/skel/"
  install -Dm644 ./etc/skel/.viminfo "$pkgdir/etc/skel/.viminfo"
  install -Dm644 ./etc/skel/.vimrc "$pkgdir/etc/skel/.vimrc"
}

